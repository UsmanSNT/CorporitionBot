[Unit]
Description=Cooperation Watcher Telegram Bot
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/cooperation-watcher-bot
EnvironmentFile=/home/ubuntu/cooperation-watcher-bot/.env
ExecStart=/home/ubuntu/cooperation-watcher-bot/.venv/bin/python -m app.main
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
